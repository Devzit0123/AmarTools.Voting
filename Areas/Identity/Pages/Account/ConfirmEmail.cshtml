@page
@model AmarTools.Voting.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    Func<object?, object> body = @<div class="text-center">
        @if (Model.Succeeded)
        {
            <p>Your account is active. You can sign in now.</p>
            @if (Model.LinkedVoterSlots > 0)
            {
                <div class="alert alert-success small">
                    You are registered as a voter in @Model.LinkedVoterSlots voting program(s).
                </div>
            }
            <a asp-page="./Login" class="btn btn-primary btn-lg w-100 fw-bold">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
            </a>
        }
        else
        {
            <p>This confirmation link is invalid or has expired.</p>
            <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-primary w-100">Send a new link</a>
        }
    </div>;
    var card = new AuthCardModel
    {
        Title = Model.Succeeded ? "Email confirmed" : "Link not valid",
        Icon = Model.Succeeded ? "bi-check-circle-fill" : "bi-x-circle-fill",
        IconClass = Model.Succeeded ? "is-success" : "is-danger",
        Body = (Microsoft.AspNetCore.Html.IHtmlContent)body(null)
    };
}
<partial name="_AuthCard" model="card" />
