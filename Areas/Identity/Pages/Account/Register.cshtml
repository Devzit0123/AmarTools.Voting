@page
@model AmarTools.Voting.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<style>
    .password-strength {
        display: none;
        height: 6px;
        background-color: var(--color-border);
        border-radius: 3px;
        margin-top: 8px;
        overflow: hidden;
    }

    .password-strength.show {
        display: block;
    }

    .password-strength-bar {
        height: 100%;
        border-radius: 3px;
        transition: all 300ms ease;
        width: 0%;
    }

    .password-strength-bar.weak {
        width: 33%;
        background-color: var(--color-danger-500);
    }

    .password-strength-bar.fair {
        width: 66%;
        background-color: var(--color-warning-500);
    }

    .password-strength-bar.strong {
        width: 100%;
        background-color: var(--color-success-500);
    }

    .auth-benefits {
        background-color: var(--color-primary-50);
        border-left: 4px solid var(--color-primary-600);
        border-radius: var(--radius-md);
        padding: var(--spacing-4);
        margin-bottom: var(--spacing-6);
        font-size: 0.9rem;
    }

    .auth-benefits ul {
        margin: 0;
        padding-left: 20px;
    }

    .auth-benefits li {
        color: var(--color-text-secondary);
        margin-bottom: 6px;
    }

    .auth-benefits strong {
        color: var(--color-primary-700);
    }
</style>

<div class="row justify-content-center align-items-center min-vh-100 py-5">
    <div class="col-12 col-sm-11 col-md-9 col-lg-6 col-xl-5">
        <div class="card auth-card border-0 rounded-xl">
            <div class="card-body p-8">
                <div class="text-center mb-6">
                    <div class="auth-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h1 class="auth-title">Get Started</h1>
                    <p class="auth-subtitle">Create your account to launch voting programs</p>
                </div>

                <div class="auth-benefits">
                    <strong>✨ With your account, you can:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Create unlimited voting programs</li>
                        <li>Register candidates and voters</li>
                        <li>Track results in real-time</li>
                        <li>Enjoy blockchain-verified voting</li>
                    </ul>
                </div>

                <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-start gap-3 mb-6 border-0" role="alert">
                        <i class="bi bi-exclamation-circle-fill fs-5 flex-shrink-0"></i>
                        <div>
                            <strong>Please fix the errors below</strong>
                            <div class="small mt-1">Review the fields and try again.</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.FullName" class="form-label">
                            <i class="bi bi-person-fill me-1"></i> Full Name
                        </label>
                        <input asp-for="Input.FullName" 
                               class="form-control form-control-lg"
                               autocomplete="name" 
                               aria-required="true" 
                               placeholder="e.g. John Doe" />
                        <span asp-validation-for="Input.FullName" class="text-danger small mt-2 d-block"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Email" class="form-label">
                            <i class="bi bi-envelope-at me-1"></i> Email Address
                        </label>
                        <input asp-for="Input.Email" 
                               class="form-control form-control-lg"
                               autocomplete="username" 
                               aria-required="true" 
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-2 d-block"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password" class="form-label">
                            <i class="bi bi-key me-1"></i> Password
                        </label>
                        <input asp-for="Input.Password" 
                               class="form-control form-control-lg"
                               autocomplete="new-password" 
                               aria-required="true" 
                               placeholder="At least 8 characters"
                               id="passwordInput" />
                        <div class="password-strength" id="passwordStrength">
                            <div class="password-strength-bar" id="passwordStrengthBar"></div>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-2 d-block"></span>
                        <small class="text-muted mt-2 d-block">Use a mix of uppercase, lowercase, numbers, and symbols for a strong password.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword" class="form-label">
                            <i class="bi bi-shield-check me-1"></i> Confirm Password
                        </label>
                        <input asp-for="Input.ConfirmPassword" 
                               class="form-control form-control-lg"
                               autocomplete="new-password" 
                               aria-required="true" 
                               placeholder="Repeat your password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-2 d-block"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-base">
                        <i class="bi bi-person-check-fill me-2"></i> Create Account
                    </button>
                </form>

                <div class="auth-footer">
                    <p class="auth-footer-text">
                        Already have an account?
                    </p>
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple password strength indicator
    const passwordInput = document.getElementById('passwordInput');
    const passwordStrength = document.getElementById('passwordStrength');
    const passwordStrengthBar = document.getElementById('passwordStrengthBar');

    if (passwordInput) {
        passwordInput.addEventListener('input', function () {
            const pwd = this.value;
            if (pwd.length === 0) {
                passwordStrength.classList.remove('show');
                return;
            }
            passwordStrength.classList.add('show');

            let strength = 0;
            if (pwd.length >= 8) strength++;
            if (pwd.match(/[a-z]/)) strength++;
            if (pwd.match(/[A-Z]/)) strength++;
            if (pwd.match(/[0-9]/)) strength++;
            if (pwd.match(/[^a-zA-Z0-9]/)) strength++;

            passwordStrengthBar.classList.remove('weak', 'fair', 'strong');
            if (strength < 2) {
                passwordStrengthBar.classList.add('weak');
            } else if (strength < 4) {
                passwordStrengthBar.classList.add('fair');
            } else {
                passwordStrengthBar.classList.add('strong');
            }
        });
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
