@page
@model AmarTools.Voting.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    Func<object?, object> body = @<div>
        @if (Model.Sent)
        {
            <div class="alert alert-success" role="status">
                If an account exists for that email, we have sent a link to reset the password.
            </div>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small mt-2 d-block"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Send reset link</button>
            </form>
        }
    </div>;
    var card = new AuthCardModel
    {
        Title = "Forgot password?",
        Subtitle = "Enter your email and we will send you a reset link.",
        Icon = "bi-key",
        Body = (Microsoft.AspNetCore.Html.IHtmlContent)body(null)
    };
}
<partial name="_AuthCard" model="card" />
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
