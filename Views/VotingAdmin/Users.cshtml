@model IEnumerable<AmarTools.Voting.Controllers.VotingAdminController.UserRow>

@{
    ViewData["Title"] = "Users";
    var rows = Model?.ToList() ?? new();
    var q = ViewBag.Query as string;
}

<div class="page-header">
    <div>
        <div class="page-title">Users</div>
        <div class="page-subtitle">New accounts are voters. Grant the Program Owner role to let someone create voting programs.</div>
    </div>
</div>

<form method="get" class="d-flex gap-2 mb-4" role="search">
    <label for="userSearch" class="visually-hidden">Search users</label>
    <input id="userSearch" name="q" value="@q" class="form-control" placeholder="Search by name or email" />
    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Search</button>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Email confirmed</th>
                    <th scope="col">Role</th>
                    <th scope="col" class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No users found.</td></tr>
                }
                @foreach (var u in rows)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.EmailConfirmed)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Yes</span>
                            }
                            else
                            {
                                <span class="text-muted">Not yet</span>
                            }
                        </td>
                        <td>
                            @if (u.IsAdmin) { <span class="badge bg-dark">Admin</span> }
                            @if (u.IsProgramOwner) { <span class="badge bg-primary">Program Owner</span> }
                            @if (!u.IsAdmin && !u.IsProgramOwner) { <span class="badge bg-light text-dark border">Voter</span> }
                        </td>
                        <td class="text-end">
                            @if (!u.IsAdmin)
                            {
                                <form asp-action="SetProgramOwner" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <input type="hidden" name="grant" value="@((!u.IsProgramOwner).ToString().ToLowerInvariant())" />
                                    <input type="hidden" name="q" value="@q" />
                                    @if (u.IsProgramOwner)
                                    {
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove owner role</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@(!u.EmailConfirmed)"
                                                title="@(u.EmailConfirmed ? "" : "The user must confirm their email first")">
                                            Make program owner
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (rows.Count == 200)
{
    <p class="small text-muted mt-2">Showing the first 200 users. Use the search box to find others.</p>
}
