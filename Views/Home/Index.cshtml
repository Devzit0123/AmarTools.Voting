@model IEnumerable<AmarTools.Voting.Models.VotingProgram>

@{
    ViewData["Title"] = "Welcome to AmarTools Voting";
    Layout = "/Views/Shared/_PublicLayout.cshtml";
}

@{
    // ==========================================
    // LANDING PAGE (Not Logged In)
    // Authenticated users never reach this view — HomeController redirects
    // them straight to their dashboard (ProgramOwner/MyPrograms) instead.
    // ==========================================
}

<style>
    .landing-hero {
        min-height: 100vh;
        background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-secondary-50) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .landing-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(59, 91, 219, 0.15) 0%, transparent 70%);
            border-radius: 50%;
        }

        .landing-hero::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -5%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(8, 145, 178, 0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

    .landing-content {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
    }

    .landing-badge {
        display: inline-block;
        background-color: var(--color-primary-100);
        color: var(--color-primary-700);
        padding: 0.5rem 1.25rem;
        border-radius: 99px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .landing-title {
        font-family: var(--font-family-display);
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 700;
        line-height: 1.2;
        color: var(--color-text-primary);
        margin-bottom: 1.5rem;
        letter-spacing: -0.5px;
    }

    .landing-description {
        font-size: 1.125rem;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
        line-height: 1.7;
    }

    .landing-cta {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 3rem;
    }

    .landing-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin-top: 4rem;
        padding-top: 4rem;
        border-top: 1px solid var(--color-border);
    }

    .feature-item {
        text-align: center;
    }

    .feature-icon {
        font-size: 2.5rem;
        color: var(--color-primary-600);
        margin-bottom: 1rem;
    }

    .feature-title {
        font-weight: 600;
        font-size: 1rem;
        color: var(--color-text-primary);
        margin-bottom: 0.5rem;
    }

    .feature-desc {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
    }
</style>

<div class="landing-hero">
    <div class="landing-content">
        <div class="landing-badge">
            <i class="bi bi-shield-check"></i> Enterprise-Grade Voting
        </div>

        <h1 class="landing-title">
            Secure &amp; Transparent Voting
        </h1>

        <p class="landing-description">
            Create customized voting programs, register candidates, and let your community decide with blockchain-verified security. Trust, transparency, and ease of use in one platform.
        </p>

        <div class="landing-cta">
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="~/ProgramOwner/MyPrograms"
               class="btn btn-primary btn-lg px-6 py-3 shadow-lg" style="font-weight: 600; letter-spacing: 0.3px;">
                <i class="bi bi-rocket-takeoff"></i> Get Started Now
            </a>
            <a href="#features" class="btn btn-secondary btn-lg px-6 py-3">
                <i class="bi bi-info-circle"></i> Learn More
            </a>
        </div>

        <div class="landing-features" id="features">
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="bi bi-lock"></i>
                </div>
                <div class="feature-title">Blockchain Secured</div>
                <div class="feature-desc">Immutable voting records with cryptographic verification</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="feature-title">Easy Management</div>
                <div class="feature-desc">Intuitive interface for managing candidates and voters</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div class="feature-title">Real-time Results</div>
                <div class="feature-desc">Live analytics and comprehensive voting insights</div>
            </div>
        </div>
    </div>
</div>

<style>
    .showcase-section {
        padding: 4rem 1.5rem;
        background: var(--color-surface);
    }

    .showcase-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .showcase-image {
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
        border: 1px solid var(--color-border);
        width: 100%;
        height: auto;
        max-height: 600px;
        object-fit: cover;
    }
</style>

<section class="showcase-section">
    <div class="showcase-container">
        <img src="~/image_dabb01.png" class="showcase-image"
             alt="Voting Platform UI Preview"
             onerror="this.parentElement.style.display='none'" />
    </div>
</section>
