@model IEnumerable<AmarTools.Voting.Models.Voter>

@{
    ViewData["Title"] = "My Elections";
    var registrations = Model?.ToList() ?? new List<AmarTools.Voting.Models.Voter>();
}

<div class="page-header">
    <div>
        <div class="page-title">My Elections</div>
        <div class="page-subtitle">Voting programs you are registered to vote in</div>
    </div>
</div>

@if (registrations.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted" aria-hidden="true"></i>
            <h2 class="h5 mt-3">You are not registered in any voting program yet</h2>
            <p class="text-muted mb-0">
                When an organiser adds your email as a voter, the program appears here.
                You can also open the voting link the organiser sent you.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in registrations)
        {
            var p = r.VotingProgram;
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h6 fw-bold mb-0">@p.ProgramName</h2>
                            <span class="badge @(p.IsActive ? "bg-success" : p.HasEnded ? "bg-secondary" : "bg-info")">@p.StatusDisplay</span>
                        </div>
                        <div class="small text-muted mb-3">
                            <time class="local-time" data-utc="@DateTime.SpecifyKind(p.StartTime, DateTimeKind.Utc).ToString("O")"></time>
                            –
                            <time class="local-time" data-utc="@DateTime.SpecifyKind(p.EndTime, DateTimeKind.Utc).ToString("O")"></time>
                        </div>
                        <div class="mt-auto d-flex gap-2">
                            @if (r.HasVoted)
                            {
                                <span class="text-success small fw-bold align-self-center"><i class="bi bi-check-circle-fill"></i> You voted</span>
                            }
                            else if (p.IsActive)
                            {
                                <a asp-controller="Voting" asp-action="Vote" asp-route-id="@p.Id" class="btn btn-primary btn-sm">
                                    <i class="bi bi-check2-square"></i> Vote now
                                </a>
                            }
                            <a asp-controller="Voting" asp-action="PublicResults" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm ms-auto">
                                Results
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
