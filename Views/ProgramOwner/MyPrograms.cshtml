@model IEnumerable<AmarTools.Voting.Models.VotingProgram>

@{
    ViewData["Title"] = "My Programs";
    var programs = Model?.ToList() ?? new();
    var userName = ViewBag.OwnerName as string ?? User.Identity?.Name ?? "there";
    var firstName = userName.Split(' ', '@')[0];
}

<style>
    /* ── Header ─────────────────────────────────── */
    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dash-title {
        font-family: var(--font-family-display);
        font-weight: 600;
        font-size: clamp(24px, 3vw, 30px);
        letter-spacing: -0.01em;
        color: var(--ink);
        margin-bottom: 4px;
    }

        .dash-title .accent {
            color: var(--accent);
        }

    .dash-subtitle {
        color: var(--ink-3, #6b7080);
        font-size: 14.5px;
        margin: 0;
    }

    /* ── Stat tiles ─────────────────────────────── */
    .stat-tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
        margin-bottom: 32px;
    }

    .stat-tile {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #fff;
        border: 1px solid var(--border, #e4e6ef);
        border-radius: var(--radius-lg, 16px);
        padding: 18px 20px;
        transition: transform var(--transition-base, 180ms ease), box-shadow var(--transition-base, 180ms ease);
    }

        .stat-tile:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md, 0 6px 20px rgba(15,17,23,0.08));
        }

    .stat-tile-icon {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .stat-tile-icon--primary {
        background: var(--color-primary-50, #eef1fd);
        color: var(--color-primary-600, #2f4abf);
    }

    .stat-tile-icon--success {
        background: var(--color-success-50, #e9f9ec);
        color: var(--color-success-700, #217032);
    }

    .stat-tile-icon--neutral {
        background: var(--color-gray-100, #eef0f6);
        color: var(--color-gray-600, #6b7080);
    }

    .stat-tile-icon--warning {
        background: var(--color-warning-50, #fff6e6);
        color: var(--color-warning-700, #a85e00);
    }

    .stat-tile-value {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.1;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
    }

    .stat-tile-label {
        font-size: 13px;
        color: var(--ink-3, #6b7080);
        margin-top: 1px;
    }

    /* ── Empty state ────────────────────────────── */
    .empty-panel {
        background: linear-gradient(135deg, #eef1fd 0%, #eefaf1 100%);
        border: 1px solid var(--border, #e4e6ef);
        border-radius: var(--radius-xl, 20px);
        padding: 56px 32px;
        text-align: center;
    }

    .empty-panel-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fff;
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(15,17,23,0.06));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: var(--accent);
    }

    /* ── Program cards ──────────────────────────── */
    .prog-card {
        background: #fff;
        border-radius: var(--radius-lg, 16px);
        border: 1px solid var(--border, #e4e6ef);
        overflow: hidden;
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(15,17,23,0.06));
        transition: box-shadow var(--transition-base, 180ms ease), transform var(--transition-base, 180ms ease);
    }

        .prog-card:hover {
            box-shadow: var(--shadow-md, 0 6px 20px rgba(15,17,23,0.08));
            transform: translateY(-3px);
        }

    .prog-card-header {
        padding: 22px 22px 14px;
    }

    .prog-card-footer {
        padding: 12px 16px;
        background: var(--color-surface-secondary, #fafbfd);
        border-top: 1px solid var(--border, #e4e6ef);
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        align-items: center;
    }

    .icon-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid var(--border, #e4e6ef);
        background: #fff;
        color: var(--ink-2, #3a3d4a);
        transition: all var(--transition-fast, 120ms ease);
    }

        .icon-btn:hover {
            background: var(--color-primary-50, #eef1fd);
            border-color: var(--color-primary-200, #b8c4f5);
            color: var(--color-primary-600, #2f4abf);
        }

    .icon-btn--danger:hover {
        background: var(--color-danger-50, #fdecec);
        border-color: var(--color-danger-200, #f3aaaa);
        color: var(--color-danger-600, #e03131);
    }

    .status-chip {
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px 5px 8px;
        border-radius: 99px;
        flex-shrink: 0;
    }

        .status-chip i {
            font-size: 7px;
        }

    .prog-status-active {
        background: var(--color-success-50, #e9f9ec);
        color: var(--color-success-700, #217032);
    }

    .prog-status-ended {
        background: var(--color-gray-100, #eef0f6);
        color: var(--color-gray-600, #6b7080);
    }

    .prog-status-upcoming {
        background: var(--color-info-50, #eaf2ff);
        color: var(--color-info-600, #1d6fdb);
    }

    .prog-status-draft {
        background: var(--color-warning-50, #fff6e6);
        color: var(--color-warning-700, #a85e00);
    }

    .stat-pill {
        font-size: 12.5px;
        color: var(--ink-3, #6b7080);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
</style>

<!-- Header -->
<div class="dash-header">
    <div>
        <h1 class="dash-title">Welcome back, <span class="accent">@firstName</span></h1>
        <p class="dash-subtitle">Here's how your voting programs are doing.</p>
    </div>
    <a asp-controller="ProgramOwner" asp-action="Create" class="btn btn-primary btn-lg px-4">
        <i class="bi bi-plus-lg me-1"></i> New Program
    </a>
</div>

<!-- Stat tiles -->
@{
    var total = programs.Count;
    var active = programs.Count(p => p.IsActive);
    var ended = programs.Count(p => p.HasEnded);
    var totalVotes = programs.Sum(p => p.TotalVotes);
}
<div class="stat-tiles">
    <div class="stat-tile">
        <div class="stat-tile-icon stat-tile-icon--primary"><i class="bi bi-collection"></i></div>
        <div>
            <div class="stat-tile-value">@total</div>
            <div class="stat-tile-label">Total programs</div>
        </div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon stat-tile-icon--success"><i class="bi bi-broadcast"></i></div>
        <div>
            <div class="stat-tile-value">@active</div>
            <div class="stat-tile-label">Active now</div>
        </div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon stat-tile-icon--neutral"><i class="bi bi-flag"></i></div>
        <div>
            <div class="stat-tile-value">@ended</div>
            <div class="stat-tile-label">Ended</div>
        </div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-icon stat-tile-icon--warning"><i class="bi bi-bar-chart-line"></i></div>
        <div>
            <div class="stat-tile-value">@totalVotes</div>
            <div class="stat-tile-label">Total votes</div>
        </div>
    </div>
</div>

@if (!programs.Any())
{
    <div class="empty-panel">
        <div class="empty-panel-icon"><i class="bi bi-ballot"></i></div>
        <h3 class="fw-bold mb-2" style="font-family:var(--font-family-display);">No programs yet</h3>
        <p class="text-muted mb-4">Create your first voting program — for elections, events, polls, and more.</p>
        <a asp-controller="ProgramOwner" asp-action="Create" class="btn btn-primary btn-lg px-5">
            <i class="bi bi-plus-lg me-1"></i> Create first program
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in programs)
        {
            string statusCss, statusText;
            if (!p.IsPublished) { statusCss = "prog-status-draft"; statusText = "Draft"; }
            else if (p.IsActive) { statusCss = "prog-status-active"; statusText = "Active"; }
            else if (p.HasEnded) { statusCss = "prog-status-ended"; statusText = "Ended"; }
            else { statusCss = "prog-status-upcoming"; statusText = "Upcoming"; }

            <div class="col-md-6 col-xl-4">
                <div class="prog-card h-100">
                    <div class="prog-card-header">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <h5 class="fw-bold mb-0" style="line-height:1.3;">@p.ProgramName</h5>
                            <span class="status-chip @statusCss">
                                <i class="bi bi-circle-fill"></i> @statusText
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(p.Description))
                        {
                            <p class="text-muted small mb-3" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">@p.Description</p>
                        }
                        <div class="d-flex gap-3 flex-wrap mt-2">
                            <span class="stat-pill"><i class="bi bi-person-badge"></i> @p.CandidateCount candidates</span>
                            <span class="stat-pill"><i class="bi bi-check-square"></i> @p.TotalVotes votes</span>
                            <span class="stat-pill"><i class="bi bi-people"></i> @(p.Voters?.Count ?? 0) voters</span>
                        </div>
                        <div class="mt-2 small text-muted">
                            <i class="bi bi-calendar3 me-1"></i>
                            @p.StartTime.ToLocalTime().ToString("MMM dd") – @p.EndTime.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>
                    </div>
                    <div class="prog-card-footer">
                        <a asp-controller="ProgramOwner" asp-action="Edit" asp-route-id="@p.Id"
                           class="icon-btn" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-controller="ProgramOwner" asp-action="ManageCandidates" asp-route-programId="@p.Id"
                           class="icon-btn" title="Candidates">
                            <i class="bi bi-person-badge"></i>
                        </a>
                        <a asp-controller="ProgramOwner" asp-action="ManageVoters" asp-route-programId="@p.Id"
                           class="icon-btn" title="Voters">
                            <i class="bi bi-people"></i>
                        </a>
                        <a asp-controller="ProgramOwner" asp-action="Results" asp-route-id="@p.Id"
                           class="icon-btn" title="Results">
                            <i class="bi bi-bar-chart"></i>
                        </a>
                        <form asp-controller="ProgramOwner" asp-action="Delete" asp-route-id="@p.Id" method="post"
                              onsubmit="return confirm('Delete this program? This can\'t be undone.');" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="icon-btn icon-btn--danger border-0" title="Delete program"
                                    style="border:1px solid var(--border,#e4e6ef) !important;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                        @if (p.IsPublished)
                        {
                            <a asp-controller="Voting" asp-action="Vote" asp-route-id="@p.Id"
                               class="btn btn-sm btn-primary ms-auto" target="_blank" title="Open voting page">
                                <i class="bi bi-box-arrow-up-right"></i> Vote link
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
